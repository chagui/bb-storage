load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//tools:container.bzl", "container_push_official", "multiarch_go_image")

go_library(
    name = "sync_jwks_to_configmap_lib",
    srcs = [
        "jwks_merge.go",
        "main.go",
    ],
    importpath = "github.com/buildbarn/bb-storage/cmd/sync_jwks_to_configmap",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/http/client",
        "//pkg/program",
        "//pkg/proto/configuration/sync_jwks_to_configmap",
        "//pkg/util",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_client_go//applyconfigurations/core/v1:core",
        "@io_k8s_client_go//applyconfigurations/meta/v1:meta",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "sync_jwks_to_configmap",
